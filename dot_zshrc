# --- PATH básico ---
export PATH="$HOME/bin:/usr/local/bin:$PATH"
typeset -U PATH

# --- Prompt minimalista ---
# Prompt minimalista azul neón
setopt prompt_subst
autoload -U colors && colors
PROMPT='%F{#66ccff}%~%f
%F{#00cfff}>%f '

# --- Aliases ---
alias l='eza --icons --group-directories-first'
alias ls='eza -a --icons --group-directories-first'
alias ll='eza -lh --icons --group-directories-first'
alias la='eza -lah --icons --group-directories-first'
alias tree='eza --tree --icons'
alias cat='bat --paging=never'
alias calendar='cal -y --monday'

alias update='sudo pacman -Syu && yay -Syu && yay -Yc && sudo bootctl update'

alias jflap='java -jar ~/Informatica/3/TALF/JFLAP.jar &'
alias pilar='java -jar Informatica/3/SegInf/practica2/pilar_rm_2025.1/pilar_rm.jar &'
alias spotifycrack='bash <(curl -sSL https://spotx-official.github.io/run.sh)'

# --- History ---
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt append_history
setopt share_history
setopt hist_ignore_all_dups
setopt hist_reduce_blanks

# --- Completion ---
autoload -Uz compinit
compinit

# --- Code Lyoko colors ---
export LS_COLORS="
di=38;5;39:\
ln=38;5;45:\
so=38;5;207:\
pi=38;5;81:\
ex=38;5;46:\
bd=38;5;81:\
cd=38;5;81:\
su=38;5;196:\
sg=38;5;196:\
tw=38;5;45:\
ow=38;5;45"

# --- Binds ---
bindkey "\e[1~" beginning-of-line
bindkey "\e[4~" end-of-line
bindkey "\e[H" beginning-of-line
bindkey "\e[F" end-of-line
bindkey "^[[1;5D" backward-word
bindkey "^[[1;5C" forward-word
bindkey "^[[3~" delete-char
